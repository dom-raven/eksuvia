# Build output.
#
# The binary pattern is anchored with a leading slash on purpose: a bare
# "eksuvia" matches any path segment with that name, which silently excludes
# cmd/eksuvia/ and ships a repo that cannot be built.
/bin/
/dist/
/eksuvia

# Local state: per-cluster signing keys and webhook configs.
# These must never be committed.
/.eksuvia/
*.pem
sa.key
sa.pub

# Go
*.test
*.out
coverage.*

# Editors / OS
.DS_Store
.idea/
.vscode/
